POINT (1 2)

statement ok
SELECT geosilo_encode(ST_GeomFromText('LINESTRING(0 0, 1 1, 2 2)'));

statement ok
SELECT geosilo_encode(ST_GeomFromText('LINESTRING(500000.25 4649776.75, 500010.5 4649780)'), 100);

statement ok
SELECT geosilo_encode(ST_Point(1, 2));

statement ok
SELECT geosilo_encode(ST_Point(1.234, 5.678), 1000000);

query I
SELECT geosilo_metadata(geosilo_encode(ST_Point(1, 2)));
----
{'geometry_type': POINT, 'vertex_type': XY, 'scale': 10000000}

query I
SELECT geosilo_metadata(geosilo_encode(ST_Point(1, 2))::GEOSILO);
----
{'geometry_type': POINT, 'vertex_type': XY, 'scale': 10000000}

# --- BLOB -> GEOSILO cast ---

# Full-header blobs (caller-supplied scale) cast and keep their scale
query II
SELECT ST_AsText(geosilo_encode(ST_GeomFromText('LINESTRING(500000.25 4649776.75, 500010.5 4649780)'), 100)::GEOSILO),
       geosilo_metadata(geosilo_encode(ST_Point(1.234, 5.678), 1000000)::GEOSILO).scale;
----
LINESTRING (500000.25 4649776.75, 500010.5 4649780)	1000000

# The cast is a validated copy of the bytes: decoding through GEOSILO or the raw BLOB gives the same geometry
query I
SELECT ST_AsText(geosilo_decode(b::GEOSILO)) = ST_AsText(geosilo_decode(b))
FROM (SELECT geosilo_encode(ST_GeomFromText('POLYGON((0 0, 4 0, 4 3, 0 3, 0 0))')) AS b) t;
----
true

query I
SELECT NULL::BLOB::GEOSILO IS NULL;
----
true

statement error
SELECT '\x00\x01'::BLOB::GEOSILO;
----
GeoSilo: invalid magic byte 0x00

statement error
SELECT ''::BLOB::GEOSILO;
----
GeoSilo: blob is empty

statement error
SELECT '\x47\x01'::BLOB::GEOSILO;
----
GeoSilo: blob too small

statement error
SELECT '\x47\x01\x09\x00\x80\x96\x98\x00\x00\x00\x00\x00'::BLOB::GEOSILO;
----
GeoSilo: invalid geometry type 9

query I
SELECT TRY_CAST(b AS GEOSILO) IS NULL FROM (VALUES ('\x00\x01'::BLOB), (''::BLOB)) t(b);
----
true
true

# The cast is explicit only: a BLOB is not silently accepted where GEOSILO is expected
statement error
SELECT ST_Area(geosilo_encode(ST_Point(1, 2)));
----
No function matches
