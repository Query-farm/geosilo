----
POINT (1 2)

query I
SELECT geosilo_decode(silo_col) FROM (SELECT ST_Point(1, 2)::GEOSILO AS silo_col) t
----
POINT (1 2)

query I
SELECT geosilo_decode(geosilo_encode(ST_Point(1, 2))::GEOSILO);
