# name: test/sql/geosilo_examples.test
# description: every example in the geosilo function descriptions runs, and BLOB casts to GEOSILO
# group: [geosilo]

require geosilo

statement ok
INSTALL spatial;

statement ok
LOAD spatial;

# The examples registered in the function descriptions. If an example changes, update the list below and the
# statement that runs it.
query II
SELECT function_name, example
FROM (SELECT DISTINCT function_name, unnest(examples) AS example
      FROM duckdb_functions()
      WHERE function_name LIKE 'geosilo%' OR list_contains(parameter_types, 'GEOSILO'))
ORDER BY ALL;
----
ST_Area	ST_Area(geosilo_encode(ST_GeomFromText('POLYGON((0 0, 4 0, 4 3, 0 3, 0 0))'))::GEOSILO)
ST_GeometryType	ST_GeometryType(geosilo_encode(ST_Point(1, 2))::GEOSILO)
ST_IsEmpty	ST_IsEmpty(geosilo_encode(ST_GeomFromText('POINT EMPTY'))::GEOSILO)
ST_Length	ST_Length(geosilo_encode(ST_GeomFromText('LINESTRING(0 0, 3 4)'))::GEOSILO)
ST_NPoints	ST_NPoints(geosilo_encode(ST_GeomFromText('LINESTRING(0 0, 1 1, 2 2)'))::GEOSILO)
ST_Perimeter	ST_Perimeter(geosilo_encode(ST_GeomFromText('POLYGON((0 0, 4 0, 4 3, 0 3, 0 0))'))::GEOSILO)
ST_X	ST_X(geosilo_encode(ST_Point(1.5, 2.5))::GEOSILO)
ST_XMax	ST_XMax(geosilo_encode(ST_GeomFromText('LINESTRING(0 0, 5 5)'))::GEOSILO)
ST_XMin	ST_XMin(geosilo_encode(ST_GeomFromText('LINESTRING(0 0, 5 5)'))::GEOSILO)
ST_Y	ST_Y(geosilo_encode(ST_Point(1.5, 2.5))::GEOSILO)
ST_YMax	ST_YMax(geosilo_encode(ST_GeomFromText('LINESTRING(0 0, 5 5)'))::GEOSILO)
ST_YMin	ST_YMin(geosilo_encode(ST_GeomFromText('LINESTRING(0 0, 5 5)'))::GEOSILO)
geosilo_decode	SELECT geosilo_decode(blob_col) FROM (SELECT geosilo_encode(ST_Point(1, 2)) AS blob_col) t
geosilo_decode	SELECT geosilo_decode(silo_col) FROM (SELECT ST_Point(1, 2)::GEOSILO AS silo_col) t
geosilo_decode	geosilo_decode(geosilo_encode(ST_Point(1, 2))::GEOSILO)
geosilo_encode	geosilo_encode(ST_GeomFromText('LINESTRING(0 0, 1 1, 2 2)'))
geosilo_encode	geosilo_encode(ST_GeomFromText('LINESTRING(500000.25 4649776.75, 500010.5 4649780)'), 100)
geosilo_encode	geosilo_encode(ST_Point(1, 2))
geosilo_encode	geosilo_encode(ST_Point(1.234, 5.678), 1000000)
geosilo_metadata	geosilo_metadata(geosilo_encode(ST_Point(1, 2)))
geosilo_metadata	geosilo_metadata(geosilo_encode(ST_Point(1, 2))::GEOSILO)

# --- Run each example verbatim ---

